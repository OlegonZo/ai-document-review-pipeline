{
  "name": "Document review pipeline (portfolio demo)",
  "nodes": [
    {
      "parameters": {"path": "document-review", "httpMethod": "POST", "responseMode": "lastNode"},
      "id": "webhook",
      "name": "Incoming document",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [260, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://YOUR_PIPELINE_HOST:8000/webhooks/documents",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json.body) }}"
      },
      "id": "pipeline",
      "name": "Send to review pipeline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 300]
    },
    {
      "parameters": {"conditions": {"string": [{"value1": "={{ $json.status }}", "operation": "equals", "value2": "review"}]}},
      "id": "review-condition",
      "name": "Manual review needed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [740, 300]
    }
  ],
  "connections": {
    "Incoming document": {"main": [[{"node": "Send to review pipeline", "type": "main", "index": 0}]]},
    "Send to review pipeline": {"main": [[{"node": "Manual review needed?", "type": "main", "index": 0}]]}
  },
  "active": false,
  "settings": {"executionOrder": "v1"},
  "versionId": "portfolio-demo"
}
